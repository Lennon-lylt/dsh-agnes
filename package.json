{
  "name": "dsh-agnes",
  "version": "0.6.1",
  "description": "Agnes AI image/video generation for DeepSeek Harness (dsh 0.2.x line): a settings page for configuration plus a bundled `agnes` skill whose CLI does the generation.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-agnes": "./lib/cli.mjs"
  },
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cli": { "default": "./lib/cli.mjs" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agnes",
    "image-generation",
    "video-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lennon-lylt/dsh-agnes.git"
  },
  "homepage": "https://github.com/Lennon-lylt/dsh-agnes#readme",
  "bugs": {
    "url": "https://github.com/Lennon-lylt/dsh-agnes/issues"
  },
  "license": "MIT"
}
