# dependencies and local dev link
node_modules/

# smoke-test artifacts (written to the OS temp dir by default, kept out anyway)
smoke-output/
*.log

# local backups made by the install/rollback procedure
*.bak-agnes

# editor/agent backups (*.bak-<timestamp>): kept on disk, never published
*.bak-*

# the plugin's own config store lives under <DSH_HOME>/storages/agnes/, but a
# copy inside the checkout must never reach the repository either
config.json
storages/

# OS noise
Thumbs.db
.DS_Store
